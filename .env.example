# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-DEF...

# ID общего чата школы (отрицательное число для группы)
# Узнать: добавить @userinfobot в группу, он напишет ID
GENERAL_CHAT_ID=-1001234567890

# Telegram ID супер-админа (узнать у @userinfobot)
SUPERADMIN_ID=123456789

# Таймзона
TIMEZONE=Europe/Moscow

# Уровень логирования: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ── Интеграция с журналом (Django) ────────────────────────────────────────
# Бот и журнал на одной машине, поэтому обычно достаточно значения по умолчанию.
JOURNAL_API_URL=http://127.0.0.1:8000

# Общий секрет для заголовка X-Bot-Token — тот же, что в BOT_SERVICE_TOKEN
# на стороне журнала (settings). Эндпоинты дополнительно закрыты в nginx на 127.0.0.1.
BOT_SERVICE_TOKEN=
