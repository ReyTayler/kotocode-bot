# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-DEF...

# ID общего чата школы (отрицательное число для группы)
# Узнать: добавить @userinfobot в группу, он напишет ID
GENERAL_CHAT_ID=-1001234567890

# Telegram ID супер-админа (узнать у @userinfobot)
SUPERADMIN_ID=123456789

# Таймзона
TIMEZONE=Europe/Moscow

# Уровень логирования: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
