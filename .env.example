# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-DEF...

# Таймзона
TIMEZONE=Europe/Moscow

# Уровень логирования: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ── Интеграция с журналом (Django) ────────────────────────────────────────
# Бот и журнал на одной машине, поэтому обычно достаточно значения по умолчанию.
# Прод: nginx-слушатель на петле (gunicorn сидит на unix-сокете, TCP-порта нет).
# Локально с runserver — http://127.0.0.1:8000
JOURNAL_API_URL=http://127.0.0.1:8001

# Общий секрет для заголовка X-Bot-Token — тот же, что в BOT_SERVICE_TOKEN
# на стороне журнала (settings). Эндпоинты дополнительно закрыты в nginx на 127.0.0.1.
BOT_SERVICE_TOKEN=
